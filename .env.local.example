# Rename/copy this file to `.env.local` — Next.js does NOT load `.env.local.example`.
# Copy to `.env.local` (never commit real secrets).

# --- Google Sheet responses (recommended) ---
# Sheet (bind the script to this file): https://docs.google.com/spreadsheets/d/1Eo93vK5mrF6LG0sqZmodvSGx3dqc7i8ZqAaLXQeuCmk/edit
# 1) Open that Sheet → Extensions → Apps Script → paste scripts/google-apps-script-webapp.js
# 2) Set Script property WEBHOOK_SECRET to a long random value.
# 3) Deploy as Web app (Execute as: Me, Who has access: Anyone).
# 4) Put the deployment URL and the same secret here:
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbzIeitHqLYledohIPVwEqIMBFMlKu_C6VhhvMY4K0r4x8AfP8DiYjjH7H_VYS7Znuif/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=your-long-random-secret

# --- Optional: Django admin instead of / in addition to sheets (see backend/README.md) ---
# DJANGO_SIGNUP_URL=http://127.0.0.1:8000
# DJANGO_SIGNUP_INGEST_KEY=
